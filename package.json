{
  "name": "human-body-3d-atlas",
  "version": "2.0.0",
  "private": true,
  "description": "Interactive realistic 3D human anatomy atlas (real BodyParts3D meshes rendered with three.js PBR).",
  "type": "module",
  "scripts": {
    "fetch:data": "bash tools/fetch-data.sh",
    "build:models": "node --max-old-space-size=8192 tools/build-models.mjs",
    "build": "esbuild src/main.js --bundle --format=esm --minify --target=es2020 --outfile=dist/atlas.js",
    "dev": "esbuild src/main.js --bundle --format=esm --sourcemap --target=es2020 --outfile=dist/atlas.js --watch",
    "serve": "python3 server.py"
  },
  "license": "SEE LICENSE IN README.md",
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "meshoptimizer": "1.3.0"
  }
}
